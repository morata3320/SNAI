# Backend publicado en Render. No añadir /api/v1 por segunda vez.
VITE_API_URL=https://uzdi-backend-api.onrender.com/api/v1

# false = datos reales; true = demo local, sin acceder a Render.
VITE_USE_MOCK=false

# Opcional para GitHub Pages:
# VITE_BASE=/prototipo_proyecto_SNAI/app/
# VITE_ROUTER_MODE=hash

# DELETE desactivado hasta confirmar baja lógica en backend.
VITE_ENABLE_DELETE=false
